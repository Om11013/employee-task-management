generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  ASSIGNED
  DUE
  COMPLETED
}

model User {
  id            Int            @id @default(autoincrement())
  fullName      String         @db.VarChar(150)
  email         String         @unique @db.VarChar(255)
  password      String         @map("passwordHash") @db.VarChar(255)
  role          Role
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  employee      Employee?
  tasksCreated  Task[]         @relation("CreatedTasks")
  notifications Notification[]

  @@map("users")
}

model Employee {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  department  String   @db.VarChar(100)
  designation String   @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  tasks       Task[]   @relation("AssignedTasks")

  @@map("employees")
}

model Task {
  id                 Int       @id @default(autoincrement())
  title              String    @db.VarChar(255)
  description        String?   @db.Text
  priority           Priority
  status             Status    @default(PENDING)
  startDate          DateTime? @db.Date
  dueDate            DateTime? @db.Date
  assignedEmployeeId Int?      
  createdBy          Int       
  completedAt        DateTime? @db.DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  assignedEmployee   Employee? @relation("AssignedTasks", fields: [assignedEmployeeId], references: [id])
  creator            User      @relation("CreatedTasks", fields: [createdBy], references: [id])
  notifications      Notification[]
  attachments        Attachment[]

  @@map("tasks")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  taskId    Int              @map("task_id")
  type      NotificationType
  message   String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id])
  task      Task             @relation(fields: [taskId], references: [id])

  @@map("notifications")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  fileName  String?  @map("file_name") @db.VarChar(255)
  fileUrl   String?  @map("file_url") @db.VarChar(255)
  fileType  String?  @map("file_type") @db.VarChar(20)
  fileSize  Int?     @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  task      Task     @relation(fields: [taskId], references: [id])

  @@map("attachments")
}